# ============================================================
# Crop Disease Detection — .gitignore
# ============================================================

# Environment / Secrets
.env
*.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
.venv/
ENV/

# ML model weights (large binary — store in S3 / DVC)
backend/models/*.pth
backend/models/*.h5
backend/models/*.pb

# User uploads (runtime data, not source)
backend/uploads/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
test_uploads/

# Database migrations (keep if using Alembic)
# backend/migrations/versions/

# Node (if frontend tooling is added later)
node_modules/
